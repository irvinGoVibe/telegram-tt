# R2 Copilot server credentials. Copy to .env.local and keep the real key private.
R2_COPILOT_API_KEY=
R2_COPILOT_API_URL=https://api-chat.r2copilot.ai
R2_COPILOT_DEFAULT_MODEL=
THREAD_WEB_ROOT=../dist
THREAD_CLIENT_REDIRECT_PATH=/

# Development deployment URL written by `npx convex dev`.
CONVEX_URL=

# Telegram application credentials from https://my.telegram.org/apps.
TELEGRAM_API_ID=
TELEGRAM_API_HASH=

# A random 32-byte base64 value. Used to encrypt Telegram sessions.
SESSION_ENCRYPTION_KEY=
# Telegram OIDC credentials from BotFather > Login Widget.
TELEGRAM_OIDC_CLIENT_ID=
TELEGRAM_OIDC_CLIENT_SECRET=
TELEGRAM_OIDC_REDIRECT_URI=
# Set the same random 32+ character value in the server and Convex environment.
THREAD_SERVER_SECRET=
