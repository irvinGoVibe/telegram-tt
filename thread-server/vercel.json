{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "buildCommand": "npm run build:app",
  "functions": {
    "server.mjs": {
      "maxDuration": 300,
      "includeFiles": "{public/**,.convex-runtime-url,node_modules/fflate/esm/browser.js}"
    }
  },
  "rewrites": [
    {
      "source": "/(.*)",
      "destination": "/server.mjs"
    }
  ]
}
