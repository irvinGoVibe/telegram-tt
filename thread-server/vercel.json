{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "buildCommand": "npx convex deploy --cmd-url-env-var-name CONVEX_URL --cmd 'npm run build:app'",
  "functions": {
    "server.mjs": {
      "maxDuration": 300,
      "includeFiles": "{public/**,.convex-runtime-url,node_modules/fflate/esm/browser.js}"
    }
  },
  "rewrites": [
    {
      "source": "/(.*)",
      "destination": "/server.mjs"
    }
  ]
}
